# Development-only names. Supply values through your shell, IDE secret store,
# container secrets, or an approved secrets manager. Never commit real values.
AUTH_DB_URL=jdbc:mysql://localhost:3306/auth_service
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=replace-with-a-local-secret
AUTH_SERVER_PORT=8081
AUTH_ISSUER_URI=http://localhost:8081
AUTH_JWK_SET_LOCATION=file:C:/absolute/path/to/local-private-jwk-set.json
AUTH_BOOTSTRAP_CLIENT_ENABLED=true
AUTH_OIDC_CLIENT_ID=platform-bff
AUTH_OIDC_CLIENT_SECRET=replace-with-a-local-client-secret
AUTH_OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
AUTH_OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:3000/
AUTH_AUDIENCE=platform-api
AUTH_MACHINE_CLIENT_ENABLED=false
AUTH_MACHINE_CLIENT_ID=platform-e2e
AUTH_MACHINE_CLIENT_SECRET=replace-with-a-local-secret
